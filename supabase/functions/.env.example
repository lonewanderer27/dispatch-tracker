# Copy to supabase/functions/.env (gitignored) for local `supabase functions serve`.
# Point at the stub for offline e2e. The function runs in a container, so 127.0.0.1 is not the host.
# Run the stub as a container on the Supabase network (see the "Start exchange stub" step in
# .github/workflows/ci.yml), then uncomment:
# EXCHANGE_API_URL=http://exchange-stub:4010
